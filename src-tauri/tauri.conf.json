{
  "productName": "SAS Launcher",
  "version": "0.5.0",
  "identifier": "com.saslauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SAS",
        "width": 1070,
        "height": 730,
        "minWidth": 790,
        "minHeight": 565,
        "scrollBarStyle": "fluentOverlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "German",
          "Spanish",
          "SpanishInternational",
          "French",
          "Italian",
          "Dutch",
          "Portuguese",
          "PortugueseBR",
          "Russian",
          "Ukrainian",
          "Turkish",
          "Arabic",
          "Hebrew",
          "Farsi",
          "Bulgarian",
          "Swedish",
          "Norwegian",
          "Japanese",
          "Korean",
          "Vietnamese",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerHooks": "windows/preserve-install-location.nsh"
      },
      "allowDowngrades": false
    }
  }
}
